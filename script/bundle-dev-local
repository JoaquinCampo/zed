#!/usr/bin/env bash

# Wraps the debug build in "Zed Dev.app" so that it runs as one instance: the cli
# hands `zed` invocations and zed:// links to an open bundled Zed through Launch
# Services, while a bare binary always starts a new process.
#
# Copies are APFS clones, so the bundle takes no extra disk space. Run it again
# after each build. Builds without the Metal toolchain by compiling shaders at
# run time.

set -euo pipefail

cd "$(dirname "$0")/.."

# Debug builds read their assets from the checkout, found by walking up from the
# executable, so the bundle stays inside it.
destination="${1:-target}"
app="$destination/Zed Dev.app"

if [[ "${SKIP_BUILD:-}" != "1" ]]; then
    cargo build -p zed -p cli -p gpui_apple --features gpui_apple/runtime_shaders
fi

mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp -c -f target/debug/zed "$app/Contents/MacOS/zed"
cp -c -f target/debug/cli "$app/Contents/MacOS/cli"
cp -f crates/zed/resources/Document.icns "$app/Contents/Resources/Document.icns"
iconset="$(mktemp -d)/AppIcon.iconset"
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
    sips -z $size $size crates/zed/resources/app-icon-dev@2x.png \
        --out "$iconset/icon_${size}x${size}.png" > /dev/null
    sips -z $((size * 2)) $((size * 2)) crates/zed/resources/app-icon-dev@2x.png \
        --out "$iconset/icon_${size}x${size}@2x.png" > /dev/null
done
iconutil -c icns "$iconset" -o "$app/Contents/Resources/AppIcon.icns"

{
    cat <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>CFBundleDevelopmentRegion</key>
<string>en</string>
<key>CFBundleExecutable</key>
<string>zed</string>
<key>CFBundleIconFile</key>
<string>AppIcon</string>
<key>CFBundleIdentifier</key>
<string>dev.zed.Zed-Dev</string>
<key>CFBundleInfoDictionaryVersion</key>
<string>6.0</string>
<key>CFBundleName</key>
<string>Zed Dev</string>
<key>CFBundlePackageType</key>
<string>APPL</string>
<key>CFBundleShortVersionString</key>
<string>0.0.0</string>
<key>CFBundleVersion</key>
<string>0</string>
<key>LSApplicationCategoryType</key>
<string>public.app-category.developer-tools</string>
<key>LSMinimumSystemVersion</key>
<string>12.0</string>
<key>NSHighResolutionCapable</key>
<true/>
EOF
    cat crates/zed/resources/info/*.plist
    cat <<'EOF'
</dict>
</plist>
EOF
} > "$app/Contents/Info.plist"

plutil -lint -s "$app/Contents/Info.plist"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"

echo "$app"
